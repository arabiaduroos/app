    function isVocabCard(card) {
    if (!card) return false;
    if (card.type === 'vocab_table') return true;
    const rawAr = (card.arabic || card.title_ar || '').trim();
    const cleanAr = stripTashkeel(rawAr);
    if (cleanAr.includes('الكلمات الجديدة') || cleanAr.includes('كلمات جديدة') || cleanAr === 'الكلمات' || cleanAr === 'الكلمات الجديده') {
      return true;
    }
    const rawEn = (card.trans_en || card.en || card.title_en || '').toLowerCase();
    if (rawEn.includes('new vocabulary') || rawEn.includes('new words') || rawEn.includes('kalimatul jadeeda')) {
      return true;
    }
    const rawUr = (card.trans_ur || card.ur || card.title_ur || '');
    if (rawUr.includes('نئے الفاظ') || rawUr.includes('الفاظ و معانی')) {
      return true;
    }
    return false;
  }

