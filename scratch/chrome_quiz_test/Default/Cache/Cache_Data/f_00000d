  function stripLeadingEmoji(str) {
    if (!str) return '';
    return String(str).replace(/^[\p{Extended_Pictographic}\u{1F300}-\u{1FAFF}\u{2600}-\u{26FF}\u{2700}-\u{27BF}\u{FE00}-\u{FE0F}\u{200D}\s]+/u, '').trim();
  }

  function formatOptionDisplay(opt, lang) {
    if (!opt || typeof opt !== 'string') return '';
    if (!opt.includes(' • ')) return opt;
    const parts = opt.split(' • ').map(s => s.trim()).filter(Boolean);
    if (parts.length < 2) return opt;

    const isArabicScript0 = /[\u0600-\u06ff]/.test(parts[0]);
    const isLatin0 = /[a-zA-Z]/.test(parts[0]);
    const isArabicScript1 = /[\u0600-\u06ff]/.test(parts[1]);
    const isLatin1 = /[a-zA-Z]/.test(parts[1]);

    let urPart = parts[0];
    let enPart = parts[1];
    if (isArabicScript0 && isLatin1) {
      urPart = parts[0];
      enPart = parts[1];
    } else if (isLatin0 && isArabicScript1) {
      enPart = parts[0];
      urPart = parts[1];
    }

    if (lang === 'en') return enPart || opt;
    if (lang === 'ur') return urPart || opt;
    return `${urPart} • ${enPart}`;
  }

  function formatQuizPromptAndInstruction(q, lang) {
    let rawAr = (q.prompt_ar || '').trim();

    // Detect textbook exercise prefixes like اقْرَأْ وَتَرْجِمْ or اقْرَأْ وَاكْتُبْ
    const taskHeaderRegex = /^(?:[\p{Extended_Pictographic}\u{1F300}-\u{1FAFF}\u{2600}-\u{26FF}\u{2700}-\u{27BF}\u{FE00}-\u{FE0F}\u{200D}\s]+)?(اقْرَأْ\s*وَتَرْجِمْ|اقْرَأْ\s*وَاكْتُبْ|تَرْجِمْ|اخْتَرْ)\s*[:：\-—]?\s*/u;
    const taskMatch = rawAr.match(taskHeaderRegex);

    let taskPrefix = '';
    let cardText = rawAr;
    if (taskMatch) {
      taskPrefix = taskMatch[1] + ': ';
      cardText = cardText.replace(taskMatch[0], '');
    }

    cardText = stripLeadingEmoji(cardText);

    // Clean instructions: remove any parenthesized Arabic like (مَا هٰذَا؟ هٰذَا كُرْسِيٌّ.) or leaked hints
    function cleanInstructionText(str) {
      if (!str) return '';
      let s = str.replace(/\s*\([^\)]*[\u0600-\u06ff][^\)]*\)\s*/g, ' ');
      s = s.replace(/\s*\([^\)]*\)\s*$/g, '');
      return s.trim().replace(/[:：\s]+$/, '');
    }

    let instText = '';
    if (lang === 'ur') {
      let baseUr = cleanInstructionText(q.prompt_ur) || (taskPrefix ? 'صحیح ترجمہ منتخب کریں' : cleanInstructionText(q.prompt_ar));
      instText = taskPrefix ? `${taskPrefix}${baseUr}` : baseUr;
    } else if (lang === 'en') {
      let baseEn = cleanInstructionText(q.prompt_en) || (taskPrefix ? 'Select translation' : cleanInstructionText(q.prompt_ar));
      instText = taskPrefix ? `${taskPrefix}${baseEn}` : baseEn;
    } else {
      let baseUr = cleanInstructionText(q.prompt_ur);
      let baseEn = cleanInstructionText(q.prompt_en);
      let combined = baseEn && baseUr ? `${baseEn} • ${baseUr}` : (baseEn || baseUr || cleanInstructionText(q.prompt_ar));
      instText = taskPrefix ? `${taskPrefix}${combined}` : combined;
    }

    return {
      instruction: instText,
      cardText: cardText,
      isTranslationQuestion: Boolean(taskPrefix || /translation|ترجمہ/i.test(instText))
    };
  }

  function renderCurrentQuizQuestion() {
    const L = t();
    const stage = document.getElementById('quizStage');
    const bottomBar = document.getElementById('quizBottomBar');
    const checkBtn = document.getElementById('quizCheckBtn');
    const skipBtn = document.getElementById('quizSkipBtn');

    // CRITICAL: Guarantee scroll is reset to top so question headers are NEVER cut off!
    stage.scrollTop = 0;

    quiz.currentPendingQaidaKey = null;
    bottomBar.className = 'quiz-bottombar';
    checkBtn.textContent = L.checkBtn;
    checkBtn.disabled = true;
    skipBtn.textContent = L.skipBtn;
    skipBtn.classList.remove('hidden');

    quiz.answered = false;
    quiz.selectedOption = null;
    quiz.sbSelectedIndices = [];
    quiz.pairLeftIdx = null;
    quiz.pairRightIdx = null;
    quiz.pairMatchedCount = 0;

    document.getElementById('quizHeartsCount').textContent = quiz.hearts;
    const pct = Math.round(((quiz.index) / Math.max(1, quiz.questions.length)) * 100);
    document.getElementById('quizProgressFill').style.width = `${Math.max(8, pct)}%`;

    if (quiz.index >= quiz.questions.length) {
      renderQuizCompletion();
      return;
    }

    const q = quiz.questions[quiz.index];
    stage.innerHTML = '';
    stage.scrollTop = 0;

    // 1. Topbar counter badge beside green bar (e.g. Exercise (3) • 15/29)
    let badgeTxt = '';
    const tNum = q.tamreen_num || 1;
    if (state.lang === 'ur') badgeTxt = `مشق (${tNum})`;
    else if (state.lang === 'en') badgeTxt = `Exercise (${tNum})`;
    else badgeTxt = `Ex. ${tNum}`;

    const counterBadge = document.getElementById('quizCounterBadge');
    if (counterBadge) {
      counterBadge.textContent = `${badgeTxt} • ${quiz.index + 1}/${quiz.questions.length}`;
    }

    // 2. Format question instruction and card text
    const qData = formatQuizPromptAndInstruction(q, state.lang);

    const headerRow = document.createElement('div');
    headerRow.className = 'q-header-row';

    const inst = document.createElement('h3');
    inst.className = 'q-instruction';
    inst.textContent = qData.instruction;
    inst.dir = state.lang === 'en' ? 'ltr' : 'rtl';
    headerRow.appendChild(inst);
    stage.appendChild(headerRow);

    // 3. Prompt Card (NO SPOILERS: prompt text only; explanations & hints belong strictly in post-check feedback)
    const promptCard = document.createElement('div');
    promptCard.className = 'q-prompt-card';
    
    let miniLabel = '';
    let bigText = qData.cardText;
    let isBigAr = /[\u0600-\u06ff]/.test(bigText);
    
    // Audio target speaks ONLY the question prompt text, never the missing answer or full sentence
    let audioTarget = qData.cardText || q.prompt_ar || '';
    const cleanAudioPrompt = cleanArTextForAudio(audioTarget);
    const hasAudio = /[\u0600-\u06ff]/.test(cleanAudioPrompt);

    const resolvedPromptEmoji = sanitizeEmoji(q.emoji) || getContextualEmoji(qData.cardText, q.hint_ur, q.hint_en) || (quiz.unit && sanitizeEmoji(quiz.unit.emoji)) || '💬';
    let promptEmojiHtml = resolvedPromptEmoji;
    if (resolvedPromptEmoji && resolvedPromptEmoji.includes(' ') && (q.prompt_ar || '').includes('وَذٰلِكَ')) {
      const emParts = resolvedPromptEmoji.trim().split(/\s+/);
      if (emParts.length >= 2) {
        promptEmojiHtml = `<span style="font-size: 1.25em; display: inline-block;">${emParts[0]}</span> <span style="font-size: 0.72em; opacity: 0.85; display: inline-block;">${emParts[1]}</span>`;
      }
    }
    promptCard.innerHTML = `
      <span class="q-prompt-emoji">${promptEmojiHtml}</span>
      <div class="q-prompt-content">
        ${miniLabel ? `<div class="q-prompt-mini-label ar-font">${miniLabel}</div>` : ''}
        <div class="q-prompt-big-text ${isBigAr ? 'ar-font' : (state.lang === 'ur' ? 'ur-font' : 'en-font')}">${bigText}</div>
      </div>
      ${hasAudio ? `<button class="q-speak-btn" title="Listen">🔊</button>` : ''}
    `;
    const speakBtn = promptCard.querySelector('.q-speak-btn');
    if (speakBtn) {
      speakBtn.addEventListener('click', () => {
        speakArabic(cleanAudioPrompt);
      });
    }
    stage.appendChild(promptCard);

    // 3. Question Options / Interaction
    if (q.type === 'sentence_builder' && Array.isArray(q.tiles) && q.tiles.length > 0) {
      const well = document.createElement('div');
      well.className = 'sb-answer-well';
      const bank = document.createElement('div');
      bank.className = 'sb-word-bank';

      function refreshSentenceBuilder() {
        well.innerHTML = '';
        bank.innerHTML = '';

        quiz.sbSelectedIndices.forEach((tileIdx, pos) => {
          const word = q.tiles[tileIdx];
          const tileBtn = document.createElement('button');
          tileBtn.className = 'word-tile ar-font';
          tileBtn.textContent = word;
          tileBtn.addEventListener('click', () => {
            if (quiz.answered) return;
            quiz.sbSelectedIndices.splice(pos, 1);
            refreshSentenceBuilder();
          });
          well.appendChild(tileBtn);
        });

        q.tiles.forEach((word, tileIdx) => {
          const used = quiz.sbSelectedIndices.includes(tileIdx);
          const tileBtn = document.createElement('button');
          tileBtn.className = 'word-tile ar-font' + (used ? ' used' : '');
          tileBtn.textContent = word;
          tileBtn.addEventListener('click', () => {
            if (quiz.answered || used) return;
            quiz.sbSelectedIndices.push(tileIdx);
            speakArabic(word);
            refreshSentenceBuilder();
          });
          bank.appendChild(tileBtn);
        });

        checkBtn.disabled = quiz.sbSelectedIndices.length === 0;
      }

      stage.appendChild(well);
      stage.appendChild(bank);
      refreshSentenceBuilder();
    } else if (q.type === 'pair_match' && Array.isArray(q.pairs) && q.pairs.length > 0) {
      const cols = document.createElement('div');
      cols.className = 'pairs-columns';
      const leftCol = document.createElement('div');
      leftCol.className = 'pairs-col';
      const rightCol = document.createElement('div');
      rightCol.className = 'pairs-col';

      // Column Headers (Tamreen 12)
      const leftHeader = document.createElement('div');
      leftHeader.className = 'pairs-column-header ar-font';
      leftHeader.textContent = state.lang === 'ur' ? 'الْقَائِمَةُ (أ)' : (state.lang === 'en' ? 'Column (A)' : 'الْقَائِمَةُ (أ) • Column A');
      leftCol.appendChild(leftHeader);

      const rightHeader = document.createElement('div');
      rightHeader.className = 'pairs-column-header ar-font';
      rightHeader.textContent = state.lang === 'ur' ? 'الْقَائِمَةُ (ب)' : (state.lang === 'en' ? 'Column (B)' : 'الْقَائِمَةُ (ب) • Column B');
      rightCol.appendChild(rightHeader);

      const pairs = q.pairs || [];
      const rightShuffled = pairs.map((p, idx) => ({ text: p.right, origIdx: idx }))
        .sort(() => Math.random() - 0.5);

      pairs.forEach((p, idx) => {
        const btn = document.createElement('button');
        btn.className = 'pair-tile ar-font';
        btn.dataset.idx = idx;
        const leftText = p.left_ar || (state.lang === 'ur' ? p.left_ur : p.left_en);
        btn.textContent = leftText;
        btn.addEventListener('click', () => {
          if (quiz.answered || btn.classList.contains('matched')) return;
          leftCol.querySelectorAll('.pair-tile').forEach(b => b.classList.remove('selected'));
          btn.classList.add('selected');
          quiz.pairLeftIdx = idx;
          if (p.left_ar) speakArabic(p.left_ar);
          tryMatchPair(leftCol, rightCol, pairs.length);
        });
        leftCol.appendChild(btn);
      });

      rightShuffled.forEach(item => {
        const btn = document.createElement('button');
        btn.className = 'pair-tile ar-font';
        btn.dataset.idx = item.origIdx;
        btn.textContent = item.text;
        btn.addEventListener('click', () => {
          if (quiz.answered || btn.classList.contains('matched')) return;
          rightCol.querySelectorAll('.pair-tile').forEach(b => b.classList.remove('selected'));
          btn.classList.add('selected');
          quiz.pairRightIdx = item.origIdx;
          speakArabic(item.text);
          tryMatchPair(leftCol, rightCol, pairs.length);
        });
        rightCol.appendChild(btn);
      });

      cols.appendChild(leftCol);
      cols.appendChild(rightCol);
      stage.appendChild(cols);
    } else {
      // Multiple-choice options grid (rendered for ALL question types with options: sentence_reading, dialogue_qa, fill_blank, vocalization, transformation, correction, verification_qa, illustrated_qa, emoji_choice, meaning_choice, etc.)
      const grid = document.createElement('div');
      grid.className = 'q-options-grid';
      let optionsList = (Array.isArray(q.options) && q.options.length > 0) ? q.options : [];
      if (optionsList.length === 0 && q.answer) {
        optionsList = [q.answer, 'نَعَمْ', 'لَا', 'صَحِيحٌ'].filter((v, i, a) => a.indexOf(v) === i);
      }

      optionsList.forEach((opt, i) => {
        const btn = document.createElement('button');
        btn.className = 'q-option-btn';
        btn.dataset.opt = opt;

        const displayText = formatOptionDisplay(opt, state.lang);
        const isArabicText = /[\u0600-\u06ff]/.test(displayText) && !/[\u0679\u0686\u0698\u0695\u06ba\u06be\u06c1\u06d2]/.test(displayText) && !/[a-zA-Z]/.test(displayText);
        const isUrduText = /[\u0679\u0686\u0698\u0695\u06ba\u06be\u06c1\u06d2]/.test(displayText) || (state.lang === 'ur' && !isArabicText);

        let fontClass = 'en-font';
        if (isArabicText) fontClass = 'ar-font preserve-tashkeel';
        else if (isUrduText) fontClass = 'ur-font';

        btn.innerHTML = `
          <span class="${fontClass}">${displayText}</span>
          <span class="key-num">${i + 1}</span>
        `;
        btn.addEventListener('click', () => {
          if (quiz.answered) return;
          quiz.selectedOption = opt;
          grid.querySelectorAll('.q-option-btn').forEach(b => b.classList.remove('selected'));
          btn.classList.add('selected');
          checkBtn.disabled = false;
          if (isArabicText) speakArabic(opt);
        });
        grid.appendChild(btn);
      });
      stage.appendChild(grid);
    }
  }

  function tryMatchPair(leftCol, rightCol, totalPairs) {
    if (quiz.pairLeftIdx === null || quiz.pairRightIdx === null) return;
    const lBtn = leftCol.querySelector(`.pair-tile[data-idx="${quiz.pairLeftIdx}"]`);
    const rBtn = rightCol.querySelector(`.pair-tile[data-idx="${quiz.pairRightIdx}"]`);

    if (quiz.pairLeftIdx === quiz.pairRightIdx) {
      playSound('correct');
      lBtn.classList.remove('selected');
      rBtn.classList.remove('selected');
      lBtn.classList.add('matched');
      rBtn.classList.add('matched');
      quiz.pairMatchedCount += 1;
      quiz.pairLeftIdx = null;
      quiz.pairRightIdx = null;

      if (quiz.pairMatchedCount >= totalPairs) {
        quiz.selectedOption = 'matched';
        document.getElementById('quizCheckBtn').disabled = false;
        handleQuizCheck();
      }
    } else {
      playSound('wrong');
      setTimeout(() => {
        if (lBtn) lBtn.classList.remove('selected');
        if (rBtn) rBtn.classList.remove('selected');
      }, 280);
      quiz.pairLeftIdx = null;
      quiz.pairRightIdx = null;
    }
  }

  function handleQuizCheck() {
    const L = t();

    // If currently displaying an in-quiz Qaida intermission
    if (quiz.currentPendingQaidaKey) {
      quiz.seenQaidas.add(quiz.currentPendingQaidaKey);
      quiz.currentPendingQaidaKey = null;
      renderCurrentQuizQuestion();
      return;
    }

    const q = quiz.questions[quiz.index];
    if (!q) return;

    if (quiz.answered) {
      quiz.index += 1;
      renderCurrentQuizQuestion();
      return;
    }

    quiz.answered = true;
    let isCorrect = false;

    if (q.type === 'sentence_builder' && Array.isArray(q.tiles) && q.tiles.length > 0) {
      // In ordering questions, ignore commas, periods, and punctuation
      const built = quiz.sbSelectedIndices.map(i => q.tiles[i]).join(' ');
      const normalizeSentence = s => stripTashkeel(s).replace(/[\.\،\,\?\؟\!\:\"\']/g, '').replace(/\s+/g, ' ').trim();
      isCorrect = normalizeSentence(built) === normalizeSentence(q.answer);
    } else if (q.type === 'pair_match' && Array.isArray(q.pairs) && q.pairs.length > 0) {
      isCorrect = true;
    } else {
      if (q.strict_tashkeel) {
        // Strict comparison with diacritics for vowel ending drills
        isCorrect = (quiz.selectedOption || '').trim() === (q.answer || '').trim();
      } else {
        isCorrect = stripTashkeel(quiz.selectedOption) === stripTashkeel(q.answer);
      }

      document.querySelectorAll('.q-option-btn').forEach(btn => {
        btn.disabled = true;
        const match = q.strict_tashkeel
          ? btn.dataset.opt.trim() === (q.answer || '').trim()
          : stripTashkeel(btn.dataset.opt) === stripTashkeel(q.answer || '');
        if (match) {
          btn.classList.add('correct');
        } else if (btn.classList.contains('selected') && !isCorrect) {
          btn.classList.add('wrong');
        }
      });
    }

    const bottomBar = document.getElementById('quizBottomBar');
    const feedbackIcon = document.getElementById('feedbackIcon');
    const feedbackTitle = document.getElementById('feedbackTitle');
    const feedbackSub = document.getElementById('feedbackSub');
    const checkBtn = document.getElementById('quizCheckBtn');
    const skipBtn = document.getElementById('quizSkipBtn');

    skipBtn.classList.add('hidden');
    checkBtn.disabled = false;
    checkBtn.textContent = L.continueBtn;

    const rawAns = q.answer || '';
    const displayAns = formatOptionDisplay(rawAns, state.lang);
    const isArabicAns = /[\u0600-\u06ff]/.test(displayAns) && !/[\u0679\u0686\u0698\u0695\u06ba\u06be\u06c1\u06d2]/.test(displayAns) && !/[a-zA-Z]/.test(displayAns);
    const isUrduAns = /[\u0679\u0686\u0698\u0695\u06ba\u06be\u06c1\u06d2]/.test(displayAns) || (state.lang === 'ur' && !isArabicAns);
    const ansFontClass = isArabicAns ? 'ar-font preserve-tashkeel' : (isUrduAns ? 'ur-font' : 'en-font');
    const formattedAns = (isArabicAns && !q.strict_tashkeel) ? formatAr(displayAns) : displayAns;

    let explText = '';
    if (state.lang === 'ur') {
      explText = q.explanation_ur || q.hint_ur || '';
    } else if (state.lang === 'en') {
      explText = q.explanation_en || q.hint_en || '';
    } else {
      const urText = q.explanation_ur || q.hint_ur || '';
      const enText = q.explanation_en || q.hint_en || '';
      explText = (urText && enText) ? `${urText} • ${enText}` : (urText || enText || '');
    }
    if (explText === rawAns || explText === displayAns) explText = '';

    if (isCorrect) {
      quiz.correctCount += 1;
      playSound('correct');
      bottomBar.className = 'quiz-bottombar state-correct';
      feedbackIcon.textContent = '🎉';
      feedbackTitle.textContent = L.correctTitle;
      feedbackSub.innerHTML = `
        <div class="feedback-ans-row">
          <strong class="${ansFontClass} feedback-ans-highlight">${formattedAns}</strong>
        </div>
        ${explText ? `<div class="feedback-expl-text">${explText}</div>` : ''}
      `;
    } else {
      quiz.hearts = Math.max(1, quiz.hearts - 1);
      document.getElementById('quizHeartsCount').textContent = quiz.hearts;
      playSound('wrong');
      bottomBar.className = 'quiz-bottombar state-wrong';
      feedbackIcon.textContent = '❌';
      feedbackTitle.textContent = L.wrongTitle;

      let labelText = state.lang === 'ur' ? 'اصل جواب یہ تھا:' : (state.lang === 'en' ? 'The correct answer was:' : 'اصل جواب • Correct:');
      feedbackSub.innerHTML = `
        <div class="feedback-ans-row">
          <span class="feedback-ans-label">${labelText}</span>
          <strong class="${ansFontClass} feedback-ans-highlight">${formattedAns}</strong>
        </div>
        ${explText ? `<div class="feedback-expl-text">${explText}</div>` : ''}
      `;
    }
  }

  function renderQuizCompletion() {
    const L = t();
    playSound('win');
    const stage = document.getElementById('quizStage');
    const bottomBar = document.getElementById('quizBottomBar');
    const checkBtn = document.getElementById('quizCheckBtn');
    const skipBtn = document.getElementById('quizSkipBtn');

    document.getElementById('quizProgressFill').style.width = '100%';
    bottomBar.className = 'quiz-bottombar state-correct';
    skipBtn.classList.add('hidden');

    const earnedXp = 20 + quiz.correctCount * 2;
    state.xp += earnedXp;
    const prevCrowns = state.completed[quiz.unit.id] || 0;
    state.completed[quiz.unit.id] = Math.min(3, prevCrowns + 1);
    saveState();

    const accuracy = Math.round((quiz.correctCount / Math.max(1, quiz.questions.length)) * 100);

    stage.innerHTML = `
      <div style="text-align:center;padding:24px 10px">
        <div style="font-size:4.5rem;margin-bottom:10px">🏆</div>
        <h2 style="font-size:2rem;margin:0 0 8px">${L.completeTitle}</h2>
        <p style="color:var(--text-muted);font-size:1.15rem;margin:0 0 24px">
          ${quiz.unit.emoji} <span class="ar-font">${formatAr(quiz.unit.title_ar)}</span> — ${getUnitTransTopic(quiz.unit)}
        </p>
        <div style="display:flex;justify-content:center;gap:16px;flex-wrap:wrap">
          <div class="stat-chip" style="min-width:140px;padding:12px">
            <span style="font-size:1.8rem">⚡</span>
            <div>
              <strong style="font-size:1.3rem">+${earnedXp} XP</strong>
              <div style="font-size:0.85rem;color:var(--text-muted)">${L.completeEarnedXP}</div>
            </div>
          </div>
          <div class="stat-chip" style="min-width:140px;padding:12px">
            <span style="font-size:1.8rem">🎯</span>
            <div>
              <strong style="font-size:1.3rem">${accuracy}%</strong>
              <div style="font-size:0.85rem;color:var(--text-muted)">${L.completeAccuracy}</div>
            </div>
          </div>
          <div class="stat-chip" style="min-width:140px;padding:12px">
            <span style="font-size:1.8rem">👑</span>
            <div>
              <strong style="font-size:1.3rem">${state.completed[quiz.unit.id]} / 3</strong>
              <div style="font-size:0.85rem;color:var(--text-muted)">${L.completeMastery}</div>
            </div>
          </div>
        </div>
      </div>
