        // Split numbered sentences into individual cards
        const rawItems = rawText.split(/(?=\(\d+\))/).map(s => s.trim()).filter(Boolean);
        if (rawItems.length > 1) {
          const urItems = rawUr.split(/(?=\([۱-۹\d]+\)|\(\d+\))/).map(s => s.trim()).filter(Boolean);
          const enItems = rawEn.split(/(?=\(\d+\))/).map(s => s.trim()).filter(Boolean);
          rawItems.forEach((subAr, sIdx) => {
            const subUr = getValidUr((urItems[sIdx] || '').replace(/[•\s]+$/, ''), subAr);
            const subEn = getValidEn((enItems[sIdx] || '').replace(/[•\s]+$/, ''), subAr);
            const lineEmoji = getContextualEmoji(subAr, subUr, subEn) || resolvedEmoji || '💬';
            const cardObj = {
              emoji: lineEmoji,
              arabic: subAr.replace(/[•\s]+$/, ''),
              ur: subUr,
              en: subEn,
              trans: state.lang === 'ur' ? subUr : (state.lang === 'en' ? subEn : (subUr && subEn ? `${subUr} • ${subEn}` : (subUr || subEn)))
            };
            if (hasNearFar && nearEm && farEm) {
              cardObj.near_emoji = nearEm;
              cardObj.far_emoji = farEm;
            }
            cards.push(cardObj);
          });
        } else {
          const splitItems = splitLongCard(rawText, validUr, validEn, '', resolvedEmoji);
          splitItems.forEach(item => {
            if (hasNearFar && nearEm && farEm) {
              item.near_emoji = nearEm;
              item.far_emoji = farEm;
            }
          });
          cards.push(...splitItems);
        }
      } else if (bt === 'illustrated_line') {
        const splitItems = splitLongCard(rawText, validUr, validEn, '', resolvedEmoji);
        splitItems.forEach(item => {
          if (hasNearFar && nearEm && farEm) {
            item.near_emoji = nearEm;
            item.far_emoji = farEm;
          }
        });
        cards.push(...splitItems);
      } else if (bt === 'dialogue') {
        const dlgEmoji = sanitizeEmoji(b.speaker_emoji) || getContextualEmoji(b.text, validUr, validEn) || '🗣️';
        const splitItems = splitLongCard(b.text, validUr, validEn, b.speaker, dlgEmoji);
        cards.push(...splitItems);
      } else if (bt === 'section_header') {
        if (!/^(تمارين|تمرين)/.test(rawText)) {
          cards.push({
            emoji: sanitizeEmoji(b.emoji) || '📌',
            arabic: rawText,
            ur: validUr,
            en: validEn,
            trans: transTxt
          });
        }
      } else if ((bt === 'table_row' || bt === 'vocab_row') && Array.isArray(b.cells)) {
        cards.push({
          emoji: sanitizeEmoji(b.emoji) || '🔹',
          arabic: b.cells.join(' • '),
          ur: validUr,
          en: validEn,
          trans: transTxt
        });
      } else if (bt === 'text' && rawText && !/^[=\-•\s\(\)]+$/.test(rawText)) {
        const splitItems = splitLongCard(rawText, validUr, validEn, '', resolvedEmoji);
        cards.push(...splitItems);
      }
    });

    if (cards.length === 0) {
      cards.push({
        emoji: '📖',
        arabic: unit.title_ar,
        ur: unit.topic_ur || '',
        en: unit.topic_en || '',
        trans: getUnitTransTopic(unit)
      });
    }

    return cards;
  }

  function openLessonCardReader(unit) {
    lessonReader.unit = unit;
    lessonReader.cards = extractCardsFromUnit(unit);
    lessonReader.index = 0;
    lessonReader.mode = 'cards';

    // Instant Preload: Fetch all audio for this lesson into device RAM immediately
    preloadUnitAudio(unit);

    const L = t();
    document.getElementById('readerUnitBadge').textContent = L.readerBadge(unit.unit_num, formatAr(unit.title_ar));
    document.getElementById('lessonReaderModal').classList.remove('hidden');

    const stage = document.getElementById('lessonStage');
    if (stage) stage.scrollTop = 0;

    setReaderMode('cards');
    renderCurrentLessonCard();
  }

  function closeLessonCardReader() {
    document.getElementById('lessonReaderModal').classList.add('hidden');
  }

  function setReaderMode(mode) {
    lessonReader.mode = mode;
    const isCard = mode === 'cards';
    document.getElementById('readerModeCardBtn').classList.toggle('active', isCard);
    document.getElementById('readerModeFullBtn').classList.toggle('active', !isCard);
    document.getElementById('lessonCardViewport').classList.toggle('hidden', !isCard);
    document.getElementById('lessonFullScroll').classList.toggle('hidden', isCard);

    const stage = document.getElementById('lessonStage');
    if (stage) stage.scrollTop = 0;

    if (!isCard) {
      renderLessonFullText();
      if (stage) stage.scrollTop = 0;
    }
  }

  function renderCurrentLessonCard() {
    const L = t();
    const total = lessonReader.cards.length;
    const cur = lessonReader.index;
    const card = lessonReader.cards[cur];

    // Pre-warm audio in RAM for current card & next card for 0ms instant playback
    if (card) {
      preloadCardAudio(card);
      if (cur + 1 < total) {
        preloadCardAudio(lessonReader.cards[cur + 1]);
      }
    }

    // Progress bar and counter
    const pct = Math.round(((cur + 1) / Math.max(1, total)) * 100);
    document.getElementById('readerProgressFill').style.width = `${pct}%`;
    document.getElementById('readerCardCounter').textContent = L.readerCardCounter(cur + 1, total);

    const cardContainer = document.getElementById('lessonPageCard');
    const emEl = document.getElementById('lessonCardEmoji');
    const arEl = document.getElementById('lessonCardArabic');
    const transEl = document.getElementById('lessonCardTrans');
    const speakBtn = document.getElementById('lessonCardSpeakBtn');

    // Clean up any dynamic tables/grids previously added
    const oldPairs = cardContainer.querySelector('.grammar-pairs-grid');
    if (oldPairs) oldPairs.remove();
    const oldVocab = cardContainer.querySelector('.vocab-table-card');
    if (oldVocab) oldVocab.remove();
    const oldTransform = cardContainer.querySelector('.grammar-transform-container');
    if (oldTransform) oldTransform.remove();
    const oldLetterTable = cardContainer.querySelector('.letter-table-card');
    if (oldLetterTable) oldLetterTable.remove();

    arEl.style.display = 'block';
    transEl.style.display = 'block';
    arEl.className = 'lesson-card-arabic ar-font';
    const isVocab = card.type === 'vocab_table' || isVocabCard(card);
    if (isVocab) card.type = 'vocab_table';

    const isTransform = card.type === 'grammar_transform' || (card.arabic && (card.arabic.includes('➔') || card.arabic.includes('->')) && !card.arabic.includes('•'));

    const isQamari = card.type === 'qamari_table' || (card.arabic && stripTashkeel(card.arabic).includes('الحروف القمرية') && !stripTashkeel(card.arabic).includes('الشمسية'));
    const isShamsi = card.type === 'shamsi_table' || (card.arabic && stripTashkeel(card.arabic).includes('الحروف الشمسية') && !stripTashkeel(card.arabic).includes('القمرية'));

    cardContainer.classList.remove('is-vocab-table', 'is-grammar-pairs', 'is-grammar-transform', 'is-letter-table');
    const stageEl = document.getElementById('lessonStage');
    if (stageEl) stageEl.classList.toggle('has-vocab-card', isVocab || isQamari || isShamsi);

    if (isTransform) {
      cardContainer.classList.add('is-grammar-transform');
      emEl.innerHTML = card.emoji || '⭐';
      arEl.style.display = 'none';
      transEl.style.display = 'none';

      const parts = card.arabic.split(/[➔\->]/).map(s => s.trim());
      const indefAr = parts[0] || '';
      const defAr = parts[1] || '';

      const urParts = (card.trans_ur || '').split(/[➔\->]/).map(s => s.trim());
      const enParts = (card.trans_en || '').split(/[➔\->]/).map(s => s.trim());

      const indefUr = urParts[0] || '';
      const defUr = urParts[1] || '';
      const indefEn = enParts[0] || '';
      const defEn = enParts[1] || '';

      // Highlight ONLY alif-lam: "الـ" (without touching following letters like noon)
      let defArFormatted = defAr;
      const alMatch = defAr.match(/^([اأإٱ][\u064B-\u065F]?ل[\u064B-\u065F]?)(.*)$/);
      if (alMatch) {
        defArFormatted = `<span class="gt-al">${alMatch[1]}ـ</span><span class="gt-base">${alMatch[2]}</span>`;
      }

      const container = document.createElement('div');
      container.className = 'grammar-transform-container';
      container.innerHTML = `
        <div class="gt-box" style="cursor:pointer;" title="Tap to listen">
          <span class="gt-badge gt-badge-indef">نَكِرَة (Indefinite)</span>
          <span class="gt-word ar-font">${formatAr(indefAr)}</span>
          <div class="gt-meanings">
            <div class="gt-trans-en">${indefEn}</div>
            <div class="gt-trans-ur ur-font">${indefUr}</div>
          </div>
        </div>

        <div class="gt-connector">
          <span>⬇️</span>
          <span class="gt-connector-al ar-font">+ الْـ</span>
          <span>(The)</span>
          <span style="font-size:0.75rem; color:var(--text-muted); font-weight:600;">(تنوین ختم)</span>
        </div>

        <div class="gt-box is-def" style="cursor:pointer;" title="Tap to listen">
          <span class="gt-badge gt-badge-def">مَعْرِفَة (Definite)</span>
          <span class="gt-word ar-font">${defArFormatted}</span>
          <div class="gt-meanings">
            <div class="gt-trans-en" style="color:var(--duo-green-dark);">${defEn}</div>
            <div class="gt-trans-ur ur-font" style="color:var(--duo-green-dark);">${defUr}</div>
          </div>
        </div>

        <div class="gt-pill-note">
          <span>💡</span>
          <span><strong>الْـ</strong> corresponds to <strong>"The"</strong>: <em>${indefEn}</em> becomes <em>${defEn}</em></span>
        </div>
      `;

      container.querySelector('.gt-box').onclick = () => speakArabic(indefAr);
      container.querySelector('.gt-box.is-def').onclick = () => speakArabic(defAr);

      cardContainer.appendChild(container);
      speakBtn.onclick = () => speakArabic(`${indefAr} ... ${defAr}`);

    } else if (card.type === 'grammar_pairs') {
      cardContainer.classList.add('is-grammar-pairs');
      emEl.innerHTML = card.emoji || '⚖️';
      arEl.style.display = 'none';
      transEl.style.display = 'none';

      const grid = document.createElement('div');
      grid.className = 'grammar-pairs-grid';
      (card.pairs || []).forEach(p => {
        const row = document.createElement('div');
        row.className = 'grammar-pair-card';
        let indefTrans = p.ur_indef || '';
        let defTrans = p.ur_def || '';
        if (state.lang === 'en') {
          indefTrans = p.en_indef || '';
          defTrans = p.en_def || '';
        } else if (state.lang === 'both') {
          indefTrans = `${p.ur_indef || ''} • ${p.en_indef || ''}`;
          defTrans = `${p.ur_def || ''} • ${p.en_def || ''}`;
        }

        row.innerHTML = `
          <div class="grammar-pair-side">
            <span class="pair-ar ar-font preserve-tashkeel">${p.indef}</span>
            <span class="pair-trans">${indefTrans}</span>
          </div>
          <span class="grammar-arrow">➔</span>
          <div class="grammar-pair-side">
            <span class="pair-ar ar-font preserve-tashkeel">${p.def}</span>
            <span class="pair-trans">${defTrans}</span>
          </div>
        `;
        row.addEventListener('click', () => speakArabic(`${p.indef} ${p.def}`));
        grid.appendChild(row);
      });
      cardContainer.appendChild(grid);
      speakBtn.onclick = () => speakArabic(card.arabic);

    } else if (isQamari || isShamsi) {
      cardContainer.classList.add('is-letter-table');
      emEl.innerHTML = isQamari ? '🌙' : '☀️';
      arEl.style.display = 'none';
      transEl.style.display = 'none';

      const items = isQamari ? QAMARI_ITEMS : SHAMSI_ITEMS;
      const bannerClass = isQamari ? 'is-qamari' : 'is-shamsi';
      const letterClass = isQamari ? 'is-qamari' : 'is-shamsi';
      const alSpanClass = isQamari ? 'al-qamari' : 'al-shamsi';
      const bannerTitleAr = isQamari ? 'اَلْحُرُوفُ الْقَمَرِيَّةُ' : 'اَلْحُرُوفُ الشَّمْسِيَّةُ';
      const bannerTitleEn = isQamari ? 'Moon Letters' : 'Sun Letters';
      const bannerRuleAr = isQamari ? 'لَامٌ ظَاهِرَةٌ سَاكِنَةٌ (تُنْطَقُ اللَّامُ)' : 'لَامٌ مُدْغَمَةٌ (لَا تُنْطَقُ اللَّامُ وَتُشَدَّدُ الْحَرْفُ)';
      const bannerRuleEn = isQamari ? "Clear 'L' Sound (al-qamaru)" : "Silent 'L' with Shaddah (ash-shamsu)";
      const bannerIcon = isQamari ? '🌙' : '☀️';

      const tableCard = document.createElement('div');
      tableCard.className = 'letter-table-card';

      const banner = document.createElement('div');
      banner.className = `letter-table-banner ${bannerClass}`;
      banner.innerHTML = `
        <div class="banner-title kufi-font">
          <span>${bannerIcon}</span>
          <span>${bannerTitleAr} (${bannerTitleEn})</span>
        </div>
        <div class="banner-rule">
          <span class="banner-rule-ar kufi-font">${bannerRuleAr}</span>
          <span class="banner-rule-en">${bannerRuleEn}</span>
        </div>
      `;
      tableCard.appendChild(banner);

      const grid = document.createElement('div');
      grid.className = 'items-grid';

      items.forEach((item, idx) => {
        const row = document.createElement('div');
        row.className = `table-row ${isShamsi ? 'shamsi-row' : ''}`;

        // Format word with colored prefix
        let wordFormatted = item.word;
        if (isQamari) {
          wordFormatted = `<span class="${alSpanClass}">اَلْـ</span><span>${item.word.replace('اَلْـ', '')}</span>`;
        } else {
          wordFormatted = `<span class="${alSpanClass}">الـ</span><span>${item.word.replace('الـ', '')}</span>`;
        }

        let transEn = item.en;
        let transUr = item.ur;

        row.innerHTML = `
          <div class="row-ar-side">
            <span class="row-num">${idx + 1}</span>
            <span class="letter-tag ${letterClass}">${item.letter}</span>
            <span class="word-ar kufi-font">${wordFormatted}</span>
          </div>
          <div class="row-meaning-side">
            <span class="row-em-icon">${item.em}</span>
            <div class="meaning-text">
              <span class="en-text">${transEn}</span>
              <span class="ur-text ur-font">${transUr}</span>
            </div>
            <span class="audio-btn-sm" title="Listen">🔊</span>
          </div>
        `;

        row.addEventListener('click', (e) => {
          e.stopPropagation();
          speakArabic(item.word);
        });

        grid.appendChild(row);
      });

      tableCard.appendChild(grid);
      cardContainer.appendChild(tableCard);
      speakBtn.onclick = () => speakArabic(items.map(it => it.word).join('، '));

    } else if (isVocab) {
      cardContainer.classList.add('is-vocab-table');
      emEl.innerHTML = card.emoji || '🗂️';
      arEl.style.display = 'none';
      transEl.style.display = 'none';

      const vCard = document.createElement('div');
      vCard.className = 'vocab-table-card';
      const vTitle = state.lang === 'ur' ? (card.title_ur || 'نئے الفاظ') : (state.lang === 'en' ? (card.title_en || 'New Vocabulary') : `${card.title_ur || 'نئے الفاظ'} • ${card.title_en || 'New Vocabulary'}`);

      const headerBox = document.createElement('div');
      headerBox.className = 'vocab-table-header-box';
      headerBox.innerHTML = `
        <span style="font-size:1.3rem; line-height:1;">${card.emoji || '🗂️'}</span>
        <div>
          <h3 class="vocab-table-header-title ar-font">${formatAr(card.title_ar || card.arabic || 'الْكَلِمَاتُ الْجَدِيدَةُ')}</h3>
          <div class="vocab-table-header-sub ${state.lang !== 'en' ? 'ur-font' : ''}">${vTitle}</div>
        </div>
      `;
      vCard.appendChild(headerBox);

      let words = card.words;
      if (!Array.isArray(words) || words.length === 0) {
        words = getUnitVocabWords(lessonReader.unit, card);
        card.words = words;
      }
      words = words || [];
      const grid = document.createElement('div');
      let colCount = 4;
      if (words.length <= 4) colCount = words.length;
      else if (words.length >= 10) colCount = 6;
      grid.className = `vocab-words-grid grid-${colCount}-cols`;
      grid.style.setProperty('--vocab-cols', colCount);

      words.forEach(w => {
        const tile = document.createElement('div');
        tile.className = 'vocab-word-tile';
        let meaning = w.ur || '';
        if (state.lang === 'en') meaning = w.en || '';
        else if (state.lang === 'both') meaning = (w.ur && w.en) ? `${w.ur} • ${w.en}` : (w.ur || w.en || '');

        const wordEmoji = sanitizeEmoji(w.emoji) || getContextualEmoji(w.ar, w.ur, w.en) || '✨';

        tile.innerHTML = `
          <span class="vocab-tile-em">${wordEmoji}</span>
          <div class="vocab-tile-ar ar-font">${formatAr(w.ar)}</div>
          <div class="vocab-tile-trans ${state.lang !== 'en' ? 'ur-font' : ''}" dir="${state.lang === 'en' ? 'ltr' : 'rtl'}">${meaning}</div>
          <span class="vocab-tile-speaker" title="Listen">🔊</span>
        `;

        tile.addEventListener('click', () => speakArabic(w.ar));
        grid.appendChild(tile);
      });

      vCard.appendChild(grid);
      cardContainer.appendChild(vCard);
      speakBtn.onclick = () => speakArabic(words.map(w => w.ar).join('، '));

    } else {
      // Standard Card
      let nearEm = card.near_emoji;
      let farEm = card.far_emoji;
      if ((!nearEm || !farEm) && card.emoji && typeof card.emoji === 'string' && (card.arabic || '').includes('وَذٰلِكَ')) {
        const parts = card.emoji.trim().split(/\s+/);
        if (parts.length >= 2) {
          nearEm = parts[0];
          farEm = parts[1];
        }
      }

      if (nearEm && farEm) {
        emEl.innerHTML = `
          <div class="near-far-emojis">
            <div class="em-item-wrap">
              <span class="em-near">${nearEm}</span>
              <span class="em-tag near">هٰذَا (Near)</span>
            </div>
            <span class="em-arrow">➔</span>
            <div class="em-item-wrap">
              <span class="em-far">${farEm}</span>
              <span class="em-tag far">ذٰلِكَ (Far)</span>
            </div>
          </div>
        `;
      } else {
        emEl.textContent = card.emoji || '💬';
      }

      arEl.textContent = formatAr(card.arabic);
      const arLen = (card.arabic || '').length;
      if (arLen > 90) arEl.classList.add('text-long');
      else if (arLen > 50) arEl.classList.add('text-medium');

      if (state.lang === 'both') {
        const urText = getValidUr(card.ur, card.arabic);
        const enText = getValidEn(card.en, card.arabic);
        if (urText || enText) {
          transEl.innerHTML = `
            <div class="card-trans-both">
              ${urText ? `<div class="trans-ur ur-font">${urText}</div>` : ''}
              ${enText ? `<div class="trans-en en-font">${enText}</div>` : ''}
            </div>
          `;
          transEl.style.display = 'block';
        } else {
          transEl.style.display = 'none';
        }
      } else {
        const rawTrans = state.lang === 'ur' ? (card.ur || '') : (card.en || '');
        const cleanTrans = state.lang === 'ur' ? getValidUr(rawTrans, card.arabic) : getValidEn(rawTrans, card.arabic);
        if (!cleanTrans) {
          transEl.style.display = 'none';
          transEl.textContent = '';
        } else {
          transEl.textContent = cleanTrans;
          transEl.style.display = 'block';
          transEl.dir = state.lang === 'en' ? 'ltr' : 'rtl';
          transEl.className = 'lesson-card-trans ' + (state.lang === 'ur' ? 'ur-font' : 'en-font');
        }
      }

      speakBtn.onclick = () => speakArabic(card.arabic);
    }

    const lessonStage = document.querySelector('.lesson-stage');
    if (lessonStage) lessonStage.scrollTop = 0;

    // Navigation Buttons
    const prevBtn = document.getElementById('lessonPrevBtn');
    const nextBtn = document.getElementById('lessonNextBtn');
    const startExBtn = document.getElementById('lessonStartExercisesBtn');

    prevBtn.disabled = cur === 0;

    const isLastCard = cur >= total - 1;
    if (isLastCard) {
      nextBtn.classList.add('hidden');
      startExBtn.classList.remove('hidden');
    } else {
      nextBtn.classList.remove('hidden');
      startExBtn.classList.add('hidden');
    }
  }

