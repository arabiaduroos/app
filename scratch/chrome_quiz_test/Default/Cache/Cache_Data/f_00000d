  function scheduleBackgroundAudioPreload() {
    const allPaths = Array.from(new Set(Object.values(AUDIO_INDEX)));
    let index = 0;
    function loadBatch() {
      if (index >= allPaths.length) return;
      const batch = allPaths.slice(index, index + 6);
      index += 6;
      Promise.allSettled(batch.map(p => preloadAudioFile(p))).then(() => {
        if ('requestIdleCallback' in window) {
          requestIdleCallback(loadBatch, { timeout: 2500 });
        } else {
          setTimeout(loadBatch, 400);
        }
      });
    }
    if ('requestIdleCallback' in window) {
      requestIdleCallback(loadBatch, { timeout: 3500 });
    } else {
      setTimeout(loadBatch, 2000);
    }
  }

  function cleanArTextForAudio(text) {
    if (!text) return '';
    return text
      .replace(/\[.*?\]/g, '')
      .replace(/[\(（][۰-۹0-9]+[\)）]/g, '')
      .replace(/[•|⬅️➡️➔⬇️💡✨⭐\?؟\.,!:]/g, ' ')
      .replace(/\s+/g, ' ')
      .trim();
  }

  function speakArabic(text) {
    if (!text) return;
    try {
      const clean = cleanArTextForAudio(text);
      if (!clean) return;

      // 1. Check pre-rendered authentic Saudi Male voice (HamedNeural)
      const audioPath = getAudioPath(clean);
      if (audioPath) {
        if (activeAudioTTS) {
          try {
            activeAudioTTS.pause();
            activeAudioTTS.currentTime = 0;
          } catch (e) {}
        }

        // Instant play from in-memory Blob cache (0 milliseconds!)
        const cached = AUDIO_BLOB_CACHE.get(audioPath);
        if (cached) {
          activeAudioTTS = cached;
          activeAudioTTS.currentTime = 0;
          activeAudioTTS.play().catch(e => {
            console.warn('Cached audio play error, falling back:', e);
            fallbackTTS(clean);
          });
          return;
        }

        // If not yet in cache, fetch & play as soon as ready
        preloadAudioFile(audioPath).then(audioObj => {
          if (audioObj) {
            activeAudioTTS = audioObj;
            activeAudioTTS.currentTime = 0;
            activeAudioTTS.play().catch(e => {
              console.warn('Local audio play error, falling back:', e);
              fallbackTTS(clean);
            });
          }
        }).catch(() => fallbackTTS(clean));
        return;
      }

      // 2. Fallback to Dynamic TTS (Male voice preference)
      fallbackTTS(clean);
    } catch (e) {
      console.warn('speakArabic error:', e);
    }
  }

  function fallbackTTS(clean) {
    let spokenLocal = false;
    if ('speechSynthesis' in window) {
      try {
        const voices = window.speechSynthesis.getVoices() || [];
        const arVoices = voices.filter(v => v.lang && v.lang.toLowerCase().startsWith('ar'));
        const maleVoice = arVoices.find(v => {
          const n = (v.name || '').toLowerCase();
          return n.includes('hamed') || n.includes('shakir') || n.includes('maged') ||
                 n.includes('taim') || n.includes('fahed') || n.includes('ali') ||
                 n.includes('bassel') || n.includes('omar') || n.includes('jamal') ||
                 n.includes('abdullah') || n.includes('moaz') || n.includes('male') ||
                 (v.gender && v.gender.toLowerCase() === 'male');
        }) || arVoices[0];

        if (maleVoice) {
          window.speechSynthesis.cancel();
          const utter = new SpeechSynthesisUtterance(clean);
          utter.lang = maleVoice.lang || 'ar-SA';
          utter.voice = maleVoice;
          utter.pitch = 0.82; // Resonant masculine teacher tone
          utter.rate = 0.88;
          window.speechSynthesis.speak(utter);
          spokenLocal = true;
        }
      } catch (err) {
        spokenLocal = false;
      }
    }

    if (!spokenLocal) {
      if (activeAudioTTS) {
        try {
          activeAudioTTS.pause();
          activeAudioTTS.currentTime = 0;
        } catch (e) {}
      }
      const encoded = encodeURIComponent(clean);
      const url = `https://translate.google.com/translate_tts?ie=UTF-8&tl=ar&client=tw-ob&q=${encoded}`;
      activeAudioTTS = new Audio(url);
      activeAudioTTS.play().catch(e => {
        console.warn('Cloud audio playback error:', e);
      });
    }
  }

